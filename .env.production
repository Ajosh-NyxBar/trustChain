# Production Environment Variables

# Application
NODE_ENV=production
PORT=3000
APP_NAME=TrustChain

# Database
DATABASE_URL=postgres://username:password@host:5432/trustchain_prod
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=trustchain_prod
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Cache
REDIS_URL=redis://your-redis-cluster:6379
REDIS_PASSWORD=your_redis_password
REDIS_TTL=3600

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-for-production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=https://trustchain.com,https://app.trustchain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=/var/lib/trustchain/uploads

# Blockchain
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key
PRIVATE_KEY=your-deployer-private-key
CONTRACT_ADDRESS_SUPPLY_CHAIN=0x...
CONTRACT_ADDRESS_NFT=0x...

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=trustchain-uploads
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-id

# Monitoring & Logging
LOG_LEVEL=error
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Email Service (for notifications)
EMAIL_SERVICE=ses
EMAIL_FROM=noreply@trustchain.com
AWS_SES_REGION=us-east-1

# Notification Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook
