# Frontend Production Environment Variables

# API Configuration
VITE_API_URL=https://api.trustchain.com/api
VITE_WS_URL=wss://api.trustchain.com

# Blockchain Configuration
VITE_CHAIN_ID=137
VITE_CHAIN_NAME=Polygon Mainnet
VITE_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key
VITE_BLOCK_EXPLORER_URL=https://polygonscan.com

# Smart Contract Addresses
VITE_SUPPLY_CHAIN_CONTRACT=0x...
VITE_NFT_CONTRACT=0x...

# IPFS Configuration
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_PINATA_API_KEY=your-pinata-api-key
VITE_PINATA_SECRET_KEY=your-pinata-secret-key

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_BLOCKCHAIN_VERIFICATION=true

# CDN & Assets
VITE_CDN_URL=https://cdn.trustchain.com
VITE_STATIC_URL=https://static.trustchain.com

# App Configuration
VITE_APP_NAME=TrustChain
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Blockchain Supply Chain Management
