# TrustChain Frontend Environment Configuration

# Blockchain Configuration
VITE_NETWORK_ID=80001
VITE_NETWORK_NAME=mumbai
VITE_CONTRACT_ADDRESS_SUPPLY_CHAIN=
VITE_CONTRACT_ADDRESS_AUTHENTICITY_NFT=

# IPFS Configuration (Pinata)
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Application Configuration
VITE_APP_NAME=TrustChain
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=http://localhost:3001/api

# Feature Flags
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_IPFS=true
VITE_ENABLE_QR_SCANNER=true

# Analytics
VITE_ENABLE_ANALYTICS=false
VITE_GOOGLE_ANALYTICS_ID=

# Development
VITE_DEBUG_MODE=true
VITE_MOCK_BLOCKCHAIN=false
