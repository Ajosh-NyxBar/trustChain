# TrustChain Blockchain Environment Configuration

# Private Key (DO NOT COMMIT THIS TO GIT!)
# Generate a new wallet for development: https://vanity-eth.tk/
PRIVATE_KEY=your_private_key_here

# RPC URLs
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_RPC_URL=https://polygon-rpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# API Keys for verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# IPFS Configuration
IPFS_PROJECT_ID=your_infura_ipfs_project_id
IPFS_PROJECT_SECRET=your_infura_ipfs_secret
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Contract Deployment Settings
DEPLOY_GAS_LIMIT=8000000
DEPLOY_GAS_PRICE=35000000000

# Development Settings
REPORT_GAS=true
CONTRACT_SIZE_LIMIT=24576

# Frontend Integration
REACT_APP_CONTRACT_ADDRESS_SUPPLY_CHAIN=
REACT_APP_CONTRACT_ADDRESS_AUTHENTICITY_NFT=
REACT_APP_NETWORK_ID=80001
REACT_APP_NETWORK_NAME=mumbai
